# Port du serveur API (dev local uniquement, ignoré sur Vercel)
PORT=4000

# Origine autorisée pour le frontend (CORS) — l'URL publique du site
FRONTEND_URL=http://localhost:5173

# Connexion à la base Postgres (Supabase). Utilisez la chaîne "Transaction
# pooler" (port 6543) du projet Supabase — Database Settings > Connection
# string — indispensable en environnement serverless (Vercel).
# Toutes les tables de la boutique vivent dans le schéma "faty_store".
DATABASE_URL=postgresql://postgres.xxxxx:VOTRE_MOT_DE_PASSE@aws-0-xxxxx.pooler.supabase.com:6543/postgres

# Compte propriétaire créé automatiquement au tout premier démarrage
# (uniquement si aucun compte n'existe encore en base). Une fois connectée,
# la cliente peut changer son mot de passe depuis l'onglet "Mon compte" du
# back-office — ces variables ne servent qu'à amorcer le tout premier compte.
ADMIN_EMAIL=contact@fatystore.com
ADMIN_PASSWORD=change-me-1234
ADMIN_NAME=Astou Saliou

# Secret utilisé pour signer les sessions de connexion (générez une longue
# valeur aléatoire en production, ex: openssl rand -hex 32)
JWT_SECRET=change-me-super-secret-jwt-key

# Clés Stripe (mode test : https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
